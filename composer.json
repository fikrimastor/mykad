{
    "name": "fikrimastor/mykad",
    "description": "Mykad package is a laravel package, purposely to validate, parse, and format Malaysian Identity Card (MyKad) numbers.",
    "keywords": [
        "fikrimastor",
        "laravel",
        "laravel-package",
        "mykad"
    ],
    "homepage": "https://github.com/fikrimastor/mykad",
    "license": "MIT",
    "authors": [
        {
            "name": "Fikri Mastor",
            "email": "fikrimastor@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "nesbot/carbon": "^3.8",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "FikriMastor\\MyKad\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FikriMastor\\MyKad\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-mykad --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "suggest": {
        "nesbot/carbon": "Enhanced date object support for date_of_birth — returns Carbon instances instead of plain strings (^3.8)"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FikriMastor\\MyKad\\MyKadServiceProvider"
            ],
            "aliases": {
                "MyKad": "FikriMastor\\MyKad\\Facades\\MyKad"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
